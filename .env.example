# Environment Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/gitlab_readiness?sslmode=disable

# Database Connection Pool
DB_MAX_CONNS=25
DB_MAX_IDLE=5

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

# Environment
# Options: development, production
ENVIRONMENT=development

# Photo uploads + extraction (phase 2)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=20971520
# xai (default) | anthropic (stub, not implemented) | none
EXTRACTION_PROVIDER=xai
# Empty = provider default (xai: grok-4.20)
EXTRACTION_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
# NEVER commit a real key. Set it in your shell/.env (gitignored) or a Kubernetes Secret.
XAI_API_KEY=
EXTRACTION_WORKERS=2
EXTRACTION_TIMEOUT_SECONDS=120
EXTRACTION_TOLERANCE_CENTS=2
