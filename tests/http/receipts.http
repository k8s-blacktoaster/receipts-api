### Get all receipts
GET {{base_url}}/api/v1/receipts?limit=20&offset=0

### Get a specific receipt by ID (replace {id} with actual ID from creation)
GET {{base_url}}/api/v1/receipts/1

### Get another receipt by ID
GET {{base_url}}/api/v1/receipts/2

### Photo-pipeline receipt with item_number/upc, discounts, adjustments
# status: uploaded | parsing | parsed | needs_review | reviewed | failed
# source: photo | manual. All money is integer cents.
POST {{base_url}}/api/v1/receipts
Content-Type: application/json

{
  "store_name": "Example Warehouse",
  "store_number": "0481",
  "store_address": "100 Example Way, Irvine, CA 92618",
  "date": "2025-09-14",
  "subtotal_cents": 4497,
  "tax_cents": 196,
  "total_cents": 4193,
  "savings_cents": 500,
  "currency": "USD",
  "payment_method": "visa",
  "payment_last4": "0000",
  "source": "photo",
  "external_id": "photo-sample-001",
  "status": "needs_review",
  "confidence": 0.82,
  "items": [
    {
      "line_no": 1,
      "raw_text": "1234567 KS PAPER TOWEL",
      "item_number": "1234567",
      "upc": "096619000000",
      "name": "PAPER TOWEL",
      "quantity": 1,
      "unit_price_cents": 2299,
      "tax_flag": "A",
      "taxable": true
    },
    {
      "line_no": 2,
      "sku": "BANANAS",
      "name": "BANANAS",
      "quantity": 2.5,
      "unit": "lb",
      "unit_price_cents": 88,
      "line_total_cents": 220
    },
    {
      "line_no": 3,
      "name": "OLIVE OIL",
      "quantity": 1,
      "unit_price_cents": 1978
    }
  ],
  "adjustments": [
    { "kind": "coupon", "raw_text": "MFR COUPON", "amount_cents": -500 }
  ]
}

### Update a receipt (mark reviewed)
PUT {{base_url}}/api/v1/receipts/2
Content-Type: application/json

{
  "store_name": "Sprouts Farmers Market",
  "store_category": "Grocery",
  "date": "2025-08-10",
  "subtotal_cents": 20800,
  "tax_cents": 0,
  "status": "reviewed",
  "items": [
    { "sku": "CUCUMBERS", "name": "CUCUMBERS", "quantity": 1, "unit_price_cents": 198 }
  ]
}

### Validation error: invalid status (expect 400)
POST {{base_url}}/api/v1/receipts
Content-Type: application/json

{ "store_name": "Sephora", "date": "2024-08-25", "subtotal_cents": 1900, "status": "auto" }

### Swagger docs
GET {{base_url}}/swagger/doc.json

### Upload a receipt photo (multipart). 202 + receipt_id; same image again -> 200 duplicate
# Put a JPEG/PNG at tests/http/fixtures/receipt.jpg (not committed) or point at your own file.
POST {{base_url}}/api/v1/uploads
Content-Type: multipart/form-data; boundary=ReceiptBoundary

--ReceiptBoundary
Content-Disposition: form-data; name="uploaded_by_id"

1
--ReceiptBoundary
Content-Disposition: form-data; name="image"; filename="receipt.jpg"
Content-Type: image/jpeg

< ./fixtures/receipt.jpg
--ReceiptBoundary--

### Check extraction status (uploaded -> parsing -> parsed | needs_review | failed)
GET {{base_url}}/api/v1/receipts/3

### Re-run extraction for a photo receipt (e.g. after "failed")
POST {{base_url}}/api/v1/receipts/3/extract

### Upload rejected: unsupported type (expect 415)
POST {{base_url}}/api/v1/uploads
Content-Type: multipart/form-data; boundary=ReceiptBoundary

--ReceiptBoundary
Content-Disposition: form-data; name="image"; filename="note.txt"
Content-Type: text/plain

not an image
--ReceiptBoundary--

### Delete a receipt (replace {id} with actual ID)
DELETE {{base_url}}/api/v1/receipts/1

### Verify deletion - should return 404
GET {{base_url}}/api/v1/receipts/1